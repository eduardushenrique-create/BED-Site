generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?
  seoTitle       String?
  seoDescription String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Product {
  id                       String   @id @default(cuid())
  name                     String
  slug                     String   @unique
  sku                      String?
  shortDescription         String?
  description              String?
  price                    Decimal  @db.Decimal(10, 2)
  compareAtPrice           Decimal? @db.Decimal(10, 2)
  status                   String   @default("draft")
  isActive                 Boolean  @default(true)
  isFeatured               Boolean  @default(false)
  isPersonalizable         Boolean  @default(false)
  productionTimeMinDays    Int      @default(1)
  productionTimeMaxDays    Int      @default(3)
  weightGrams              Int?
  widthCm                  Decimal? @db.Decimal(10, 2)
  heightCm                 Decimal? @db.Decimal(10, 2)
  depthCm                  Decimal? @db.Decimal(10, 2)
  stock                    Int      @default(0)
  underOrder               Boolean  @default(false)
  productionMinutesPerUnit Int?

  categoryId            String?
  category              Category?              @relation(fields: [categoryId], references: [id])
  images                ProductImage[]
  variants              ProductVariant[]
  personalizationFields PersonalizationField[]
  orderItems            OrderItem[]
  reviews               Review[]
  components            ProductComponent[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Customer {
  id         String            @id @default(cuid())
  name       String
  email      String            @unique
  phone      String?
  cpf        String?
  isVerified Boolean           @default(false)
  addresses  CustomerAddress[]
  orders     Order[]
  wishlist   WishlistItem[]
  reviews    Review[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

model CustomerAddress {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label        String?
  recipient    String
  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  country      String   @default("BR")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
}

model Banner {
  id                     String   @id @default(cuid())
  title                  String
  subtitle               String?
  imageUrl               String
  storageKey             String?
  ctaText                String?
  ctaLink                String?
  isActive               Boolean  @default(true)
  displayDurationSeconds Int      @default(5)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model ProductImage {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  url        String
  storageKey String?
  alt        String?
  sortOrder  Int             @default(0)
  isMain     Boolean         @default(false)

  @@index([variantId])
}

model ProductVariant {
  id                       String   @id @default(cuid())
  productId                String
  product                  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name                     String
  sku                      String?
  color                    String?
  size                     String?
  material                 String?
  finish                   String?
  priceDelta               Decimal? @db.Decimal(10, 2)
  priceOverride            Decimal? @db.Decimal(10, 2)
  stockQuantity            Int      @default(0)
  isAvailable              Boolean  @default(true)
  productionMinutesPerUnit Int?

  orderItems OrderItem[]
  images     ProductImage[]
  components ProductComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PersonalizationField {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label       String
  fieldType   String
  placeholder String?
  helpText    String?
  isRequired  Boolean @default(false)
  minLength   Int?
  maxLength   Int?
  sortOrder   Int     @default(0)
}

model Order {
  id                 String    @id @default(cuid())
  orderNumber        String    @unique
  customerName       String
  customerEmail      String
  customerPhone      String?
  customerCpf        String?
  status             String    @default("pending")
  paymentStatus      String    @default("pending")
  fulfillmentStatus  String    @default("pending")
  subtotal           Decimal   @db.Decimal(10, 2)
  discountTotal      Decimal   @default(0) @db.Decimal(10, 2)
  shippingTotal      Decimal   @default(0) @db.Decimal(10, 2)
  total              Decimal   @db.Decimal(10, 2)
  shippingMethod     String?
  trackingCode       String?
  productionDeadline DateTime?
  expectedDeliveryAt DateTime?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items           OrderItem[]
  address         Address?
  payment         Payment?
  shipment        Shipment?
  productionTasks ProductionTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerEmail])
  @@index([customerId])
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product         @relation(fields: [productId], references: [id])
  variantId           String?
  variant             ProductVariant? @relation(fields: [variantId], references: [id])
  productNameSnapshot String
  skuSnapshot         String?
  quantity            Int
  unitPrice           Decimal         @db.Decimal(10, 2)
  total               Decimal         @db.Decimal(10, 2)
  personalizationJson String?
  productionTask      ProductionTask?
}

model Address {
  id           String  @id @default(cuid())
  orderId      String  @unique
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  country      String  @default("BR")
}

model Payment {
  id                String    @id @default(cuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String
  providerPaymentId String?
  method            String
  status            String
  amount            Decimal   @db.Decimal(10, 2)
  pixQrCode         String?
  pixCopyPaste      String?
  paidAt            DateTime?
  rawPayload        Json?
}

model Shipment {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String?
  serviceName   String?
  price         Decimal? @db.Decimal(10, 2)
  estimatedDays Int?
  trackingCode  String?
  labelUrl      String?
  status        String?
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String
  value       Decimal   @db.Decimal(10, 2)
  minSubtotal Decimal?  @db.Decimal(10, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  usageLimit  Int?
  usedCount   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model AdminUser {
  id           String               @id @default(cuid())
  name         String
  email        String               @unique
  role         String               @default("admin")
  passwordHash String
  createdAt    DateTime             @default(now())
  resetTokens  PasswordResetToken[]
}

model Printer {
  id                     String           @id @default(cuid())
  name                   String
  model                  String?
  buildVolume            String?          // ex: "180x180x180"
  materials              String?          // ex: "PLA, PETG"
  dailyCapacityMinutes   Int              @default(480)
  status                 String           @default("active") // active | maintenance | offline
  color                  String?          // hex tag para UI
  notes                  String?          @db.Text
  // Campos pra calculadora de custo (SPEC calculadora produto):
  powerConsumptionWatts  Int?
  acquisitionCostBRL     Decimal?         @db.Decimal(10, 2)
  lifetimeHours          Int?
  productionTasks        ProductionTask[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([status])
}

model Review {
  id             String    @id @default(cuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName   String
  customerEmail  String
  orderNumber    String?
  rating         Int
  title          String?
  body           String?   @db.Text
  status         String    @default("pending") // pending | approved | hidden
  moderatedAt    DateTime?
  moderatedBy    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([productId, status])
  @@index([customerId])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorEmail   String
  actorRole    String?
  action       String   // ex.: "order.refund", "order.update", "product.delete", "coupon.create"
  targetType   String   // "Order" | "Product" | "Coupon" | "Customer" | ...
  targetId     String?
  summary      String?  @db.Text
  metadata     Json?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([actorEmail])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model RestockAlert {
  id        String   @id @default(cuid())
  email     String
  productId String
  variantId String?
  notifiedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([email, productId, variantId])
  @@index([productId])
  @@index([variantId])
  @@index([notifiedAt])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
}

model AuthCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  ipHash    String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, usedAt, expiresAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  deliveryKey String    @unique
  topic       String
  resourceId  String?
  eventId     String?
  action      String?
  orderNumber String?
  paymentId   String?
  payloadHash String
  signature   String?
  status      String    @default("received")
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  lastError   String?
  updatedAt   DateTime  @updatedAt

  @@index([provider, topic, resourceId])
}

model ProductionSettings {
  id                   String   @id @default("default")
  dailyCapacityMinutes Int      @default(480)
  riskBufferHours      Int      @default(24)
  businessDaysOnly     Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ProductionTask {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  printerId   String?
  printer     Printer?  @relation(fields: [printerId], references: [id], onDelete: SetNull)

  requiredQuantity Int
  producedQuantity Int @default(0)

  status   String @default("pending")
  priority String @default("normal")

  dueAt       DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs           ProductionLog[]
  stockMovements StockMovement[]

  @@index([orderId])
  @@index([status, dueAt])
  @@index([printerId])
  @@index([priority, dueAt])
}

model EmailCampaign {
  id             String    @id @default(cuid())
  name           String
  subject        String
  htmlBody       String    @db.Text
  textBody       String?   @db.Text
  segment        Json
  status         String    @default("draft") // draft | scheduled | sending | sent | failed | cancelled
  scheduledAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  createdByEmail String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([createdAt])
}

model EmailUnsubscribe {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  source    String   @default("link") // link | admin | bounce
  createdAt DateTime @default(now())
}

model Component {
  id                String             @id @default(cuid())
  sku               String?            @unique
  name              String
  description       String?            @db.Text
  unit              String
  stock             Decimal            @default(0) @db.Decimal(12, 4)
  lowStockThreshold Decimal?           @db.Decimal(12, 4)
  supplier          String?
  supplierUrl       String?
  costPerUnit       Decimal?           @db.Decimal(10, 2)
  notes             String?            @db.Text
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  movements         StockMovement[]
  productLinks      ProductComponent[]
  lowStockAlertLog  LowStockAlertLog?

  @@index([isActive])
}

model ProductComponent {
  id              String          @id @default(cuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  componentId     String
  component       Component       @relation(fields: [componentId], references: [id], onDelete: Restrict)
  quantityPerUnit Decimal         @db.Decimal(10, 4)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([productId])
  @@index([componentId])
}

model StockMovement {
  id                 String          @id @default(cuid())
  componentId        String
  component          Component       @relation(fields: [componentId], references: [id], onDelete: Cascade)
  type               String
  quantity           Decimal         @db.Decimal(12, 4)
  balanceAfter       Decimal         @db.Decimal(12, 4)
  reason             String?
  relatedTaskId      String?
  relatedTask        ProductionTask? @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)
  relatedOrderNumber String?
  createdByEmail     String?
  createdAt          DateTime        @default(now())

  @@index([componentId, createdAt])
  @@index([type])
  @@index([relatedOrderNumber])
}

model LowStockAlertLog {
  componentId String   @id
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  lastSentAt  DateTime @default(now())
  lastBalance Decimal  @db.Decimal(12, 4)
}

model Filament {
  id         String   @id @default(cuid())
  name       String
  brand      String?
  type       String   // PLA | PETG | TPU | ABS | PETG-HF | PLA-Speed+ | Other
  pricePerKg Decimal  @db.Decimal(10, 2)
  notes      String?  @db.Text
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
  @@index([type])
}

model AlertSettings {
  id               String   @id @default("default")
  lowStockEmails   Json     @default("[]")
  orderAlertEmails Json     @default("[]")
  updatedAt        DateTime @updatedAt
}

model EmailTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  subject     String
  htmlBody    String   @db.Text
  textBody    String?  @db.Text
  variables   Json?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductionLog {
  id     String         @id @default(cuid())
  taskId String
  task   ProductionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  quantityDelta Int
  quantityAfter Int

  statusBefore String?
  statusAfter  String?

  note           String?
  createdByEmail String?
  createdByName  String?

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}
