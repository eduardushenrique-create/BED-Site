# Database (Railway PostgreSQL / Prisma)
# Railway exposes this automatically when the app service references the Postgres service.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Payment - Mercado Pago
PAYMENT_PROVIDER="mercadopago"
MERCADOPAGO_ACCESS_TOKEN="your-access-token"
MERCADOPAGO_WEBHOOK_SECRET="your-webhook-secret"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="your-public-key"

# Shipping - Melhor Envio
MELHOR_ENVIO_TOKEN="your-token"
MELHOR_ENVIO_SECRET="your-secret"

# Email - Resend
RESEND_API_KEY="re_xxxxxxxxxxxx"

# App
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_STORE_ORIGIN_ZIP="01001000"

# Sentry (opcional — sem DSN, observability fica off mas app funciona normal)
# Ver docs/implementation/setup-sentry.md para passos de ativação.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_RELEASE=
# Necessário apenas se quiser upload de sourcemaps (não obrigatório)
SENTRY_AUTH_TOKEN=

# Cloudflare R2 (object storage para imagens — opcional)
# Sem essas vars, o sistema continua salvando imagens como base64 inline (fallback automático).
# Ver docs/implementation/setup-r2.md para o passo a passo de ativação.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=  # ex: https://pub-xxxxx.r2.dev OU https://imagens.seu-dominio.com.br
